{
  "manifest_version": 3,
  "name": "Conduit Download Interceptor",
  "version": "1.2.0",
  "description": "High-speed download interception and acceleration companion for the Conduit agent daemon.",
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "notifications",
    "alarms",
    "webNavigation",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:18800/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Conduit Download Interceptor",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "conduit@local.dev",
      "strict_min_version": "109.0"
    }
  },
  "key": ""
}
