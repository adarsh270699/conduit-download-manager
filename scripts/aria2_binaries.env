# Pinned aria2 download for the Windows installer and the Windows test copy.
# Keep these values in sync with the upstream release. build_windows.ps1 and
# download_aria2_binaries.ps1 read this file. Linux has no pin here: it uses
# the aria2 package from apt.
# ARIA2_WIN_SHA256 is the SHA-256 of aria2c.exe inside the archive, not of the archive.
ARIA2_WIN_URL="https://github.com/aria2/aria2/releases/download/release-1.37.0/aria2-1.37.0-win-64bit-build1.zip"
ARIA2_WIN_SHA256="be2099c214f63a3cb4954b09a0becd6e2e34660b886d4c898d260febfe9d70c2"
